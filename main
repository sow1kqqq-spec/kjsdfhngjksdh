        types.InlineKeyboardButton("📢 Рассылка", callback_data="admin_broadcast"),
        types.InlineKeyboardButton("🔙 Закрыть", callback_data="admin_close")
    )
    return kb

def cancel_action_kb() -> types.InlineKeyboardMarkup:
    kb = types.InlineKeyboardMarkup()
    kb.add(types.InlineKeyboardButton("❌ Отмена", callback_data="admin_panel"))
    return kb

def is_subscribed(uid: int) -> bool:
    if is_admin(uid):
        return True
    try:
        member = bot.get_chat_member(CHANNEL_ID, uid)
        return member.status in ("creator", "administrator", "member", "restricted")
    except Exception as e:
        log.warning(f"Sub check failed for {uid}: {e}")
        return False

def sub_kb() -> str:
    return json.dumps({
        "inline_keyboard": [
            [
                {
                    "text": "подписаться",
                    "url": CHANNEL_URL,
                    "icon_custom_emoji_id": E_SUB_BTN
                }
            ],
            [
                {
                    "text": "проверить подписку",
                    "callback_data": "check_sub"
                }
            ]
        ]
    })

def send_sub_prompt(chat_id: int):
    bot.send_message(
        chat_id,
        f"{ce(E_SUB, '❗')} чтобы использовать бота, подпишитесь на НОВОСТИ моих ботов",
        reply_markup=sub_kb(),
        parse_mode="HTML"
    )

def ensure_sub(user: types.User | int, chat: types.Chat | None = None) -> bool:
    track_user(user)
    if chat and chat.type in ("group", "supergroup"):
        return True
    uid = user if isinstance(user, int) else user.id
    if not is_subscribed(uid):
        target_chat = chat.id if chat else uid
        send_sub_prompt(target_chat)
        return False
    return True

def detect_audio_ext(mime: str, filename: str = "") -> str | None:
    if filename:
        _, ext = os.path.splitext(filename.lower())
        if ext in FMT_NAME:
            return ext
    if mime:
        ml = mime.lower()
        for k, v in AUDIO_MIME.items():
            if ml.startswith(k):
                return v
        if "video" in ml:
            return ".mp4"
        if "audio" in ml:
            return ".mp3"
    return None

sessions: dict[tuple[int, int], dict] = {}

def _blank() -> dict:
    return {
        "step":        "WAIT_AUDIO",
        "audio_path":  None,
        "fmt":         ".mp3",
        "title":       None,
        "artist":      None,
        "cover_path":  None,
        "last_msg_id": None,
    }

def get_session(chat_id: int, uid: int) -> dict:
    key = (chat_id, uid)
    if key not in sessions:
        sessions[key] = _blank()
    return sessions[key]

def reset_session(chat_id: int, uid: int):
    sessions[(chat_id, uid)] = _blank()

def delete_last(chat_id: int, uid: int):
    u   = get_session(chat_id, uid)
    mid = u.get("last_msg_id")
    if mid:
        try: bot.delete_message(chat_id, mid)
        except Exception: pass
        u["last_msg_id"] = None

def send_step(chat_id: int, uid: int, text: str, markup=None) -> types.Message:
    delete_last(chat_id, uid)
    msg = bot.send_message(chat_id, text, reply_markup=markup, parse_mode="HTML")
    get_session(chat_id, uid)["last_msg_id"] = msg.message_id
    return msg

def skip_kb(uid: int) -> str:
    return json.dumps({
        "inline_keyboard": [[
            {
                "text": "пропустить",
                "callback_data": f"skip:{uid}",
                "icon_custom_emoji_id": E_SKIP
            }
        ]]
    })

def download_file(file_id: str, suffix: str = ".mp3") -> str:
    info = bot.get_file(file_id)
    url  = f"https://api.telegram.org/file/bot{TOKEN}/{info.file_path}"
    r = requests.get(url, timeout=120)
    r.raise_for_status()
    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=suffix)
    tmp.write(r.content)
    tmp.flush(); tmp.close()
    return tmp.name

def avatar_thumb_bytes(cover_path: str) -> bytes:
    with open(cover_path, "rb") as f:
        raw = f.read()
    img = Image.open(io.BytesIO(raw)).convert("RGB")
    img = ImageOps.fit(img, (320, 320), Image.Resampling.LANCZOS)
    for quality in (90, 80, 70, 60):
        buf = io.BytesIO()
        img.save(buf, format="JPEG", quality=quality, optimize=True)
        data = buf.getvalue()
        if len(data) < 200 * 1024:
            return data
    return data

def apply_tags(audio_path: str, fmt: str,
               title: str | None, artist: str | None,
               cover_path: str | None) -> tuple[str, str]:
    out = audio_path + "_tagged" + fmt
    shutil.copy2(audio_path, out)

    cover = avatar_thumb_bytes(cover_path) if cover_path else None

    try:
        audio = MutagenFile(out)
    except Exception:
        audio = None

    actual_fmt = fmt

    if isinstance(audio, MP4):
        actual_fmt = ".m4a"
        if title:  audio["\xa9nam"] = [title]
        if artist: audio["\xa9ART"] = [artist]
        if cover:
            audio["covr"] = [MP4Cover(cover, imageformat=MP4Cover.FORMAT_JPEG)]
        audio.save()

    elif isinstance(audio, FLAC):
        actual_fmt = ".flac"
        if title:  audio["title"]  = [title]
        if artist: audio["artist"] = [artist]
        if cover:
            pic = Picture()
            pic.type = 3; pic.mime = "image/jpeg"; pic.data = cover
            audio.clear_pictures()
            audio.add_picture(pic)
        audio.save()

    elif isinstance(audio, OggVorbis):
        actual_fmt = ".ogg"
        if title:  audio["title"]  = [title]
        if artist: audio["artist"] = [artist]
        if cover:
            pic = Picture()
            pic.type = 3; pic.mime = "image/jpeg"; pic.data = cover
            audio["metadata_block_picture"] = [
                base64.b64encode(pic.write()).decode("ascii")
            ]
        audio.save()

    elif isinstance(audio, OggOpus):
        actual_fmt = ".opus"
        if title:  audio["title"]  = [title]
        if artist: audio["artist"] = [artist]
        if cover:
            pic = Picture()
            pic.type = 3; pic.mime = "image/jpeg"; pic.data = cover
            audio["metadata_block_picture"] = [
                base64.b64encode(pic.write()).decode("ascii")
            ]
        audio.save()

    elif isinstance(audio, ASF):
        actual_fmt = ".wma"
        if title:  audio["Title"]  = [title]
        if artist: audio["Author"] = [artist]
        audio.save()

    elif isinstance(audio, WAVE):
        actual_fmt = ".wav"
        if not audio.tags: audio.add_tags()
        if title:  audio.tags["TIT2"] = TIT2(encoding=3, text=title)
        if artist: audio.tags["TPE1"] = TPE1(encoding=3, text=artist)
        if cover:
            audio.tags.delall("APIC")
            audio.tags.add(APIC(encoding=3, mime="image/jpeg",
                                type=3, desc="Cover", data=cover))
        audio.save()

    else:
        actual_fmt = ".mp3" if fmt in (".m4a", ".mp4") else fmt
        try:
            try:    tags = ID3(out)
            except ID3NoHeaderError: tags = ID3()
            if title:  tags["TIT2"] = TIT2(encoding=3, text=title)
            if artist: tags["TPE1"] = TPE1(encoding=3, text=artist)
            if cover:
                tags.delall("APIC")
                tags.add(APIC(encoding=3, mime="image/jpeg",
                              type=3, desc="Cover", data=cover))
            tags.save(out, v2_version=3)
        except Exception as e:
            log.warning(f"Fallback tag write failed ({fmt}): {e}")

    return out, actual_fmt

def ask_title(chat_id: int, uid: int):
    send_step(chat_id, uid,
        f"{ce(E_TITLE, '✏️')} Напишите новое название трека:",
        markup=skip_kb(uid))
    get_session(chat_id, uid)["step"] = "WAIT_TITLE"

def ask_artist(chat_id: int, uid: int):
    send_step(chat_id, uid,
        f"{ce(E_ARTIST, '🎤')} Напишите нового исполнителя:",
        markup=skip_kb(uid))
    get_session(chat_id, uid)["step"] = "WAIT_ARTIST"

def ask_cover(chat_id: int, uid: int):
    send_step(chat_id, uid,
        f"{ce(E_COVER, '🖼️')} Пришли новую аватарку трека:",
        markup=skip_kb(uid))
    get_session(chat_id, uid)["step"] = "WAIT_COVER"

def do_save(chat_id: int, uid: int, chat_type: str = "private"):
    u = get_session(chat_id, uid)
    delete_last(chat_id, uid)

    m1 = bot.send_message(chat_id, f"{ce(E_SEND, '📤')} отправляю файл!", parse_mode="HTML")
    time.sleep(0.6)
    try: bot.delete_message(chat_id, m1.message_id)
    except Exception: pass

    m2 = bot.send_message(chat_id, f"{ce(E_WAIT, '⏳')} ожидайте!", parse_mode="HTML")

    out_path = None
    try:
        out_path, real_fmt = apply_tags(
            u["audio_path"], u["fmt"],
            u["title"], u["artist"], u["cover_path"]
        )
    except Exception as e:
        log.exception(e)
        bot.edit_message_text(f"❌ Ошибка: {e}", chat_id, m2.message_id)
        return

    try: bot.delete_message(chat_id, m2.message_id)
    except Exception: pass

    kb = start_kb(uid, chat_type)

    fname = f"{u['artist'] or 'Unknown'} - {u['title'] or 'Track'}{real_fmt}"
    thumb_bytes = avatar_thumb_bytes(u["cover_path"]) if u.get("cover_path") else None

    try:
        with open(out_path, "rb") as f:
            thumb_file = types.InputFile(io.BytesIO(thumb_bytes), file_name="thumb.jpg") if thumb_bytes else None
            bot.send_audio(
                chat_id,
                types.InputFile(f, file_name=fname),
                title=u["title"] or None,
                performer=u["artist"] or None,
                thumbnail=thumb_file
            )
        track_user(uid, inc_track=True)
        bot.send_message(chat_id,
            f"готово {ce(E_DONE, '✅')} вот твой трек!",
            reply_markup=kb, parse_mode="HTML")
    except TypeError:
        with open(out_path, "rb") as f:
            bot.send_audio(
                chat_id,
                (fname, f),
                title=u["title"] or None,
                performer=u["artist"] or None,
                thumb=thumb_bytes
            )
        track_user(uid, inc_track=True)
        bot.send_message(chat_id,
            f"готово {ce(E_DONE, '✅')} вот твой трек!",
            reply_markup=kb, parse_mode="HTML")
    except Exception as e:
        log.exception(e)
        bot.send_message(chat_id, f"❌ Не удалось отправить: {e}")
    finally:
        for p in [u.get("audio_path"), u.get("cover_path"), out_path]:
            if p and os.path.exists(p):
                try: os.remove(p)
                except Exception: pass
        reset_session(chat_id, uid)

@bot.message_handler(commands=["start", "help"])
def cmd_start(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    reset_session(chat_id, uid)
    if not ensure_sub(msg.from_user, msg.chat):
        return
    bot.send_message(chat_id,
        f"{ce(E_MUSIC, '🎵')} Пришли трек, чтобы изменить название, исполнителя или аватарку трека.",
        reply_markup=start_kb(uid, msg.chat.type), parse_mode="HTML")

@bot.message_handler(commands=["reset"])
def cmd_reset(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    reset_session(chat_id, uid)
    if not ensure_sub(msg.from_user, msg.chat):
        return
    bot.send_message(chat_id, "🔄 Сброшено. Отправь новый трек или видео.")

@bot.message_handler(
    func=lambda m: get_session(m.chat.id, m.from_user.id).get("step") == "WAIT_IMPORT" and is_admin(m.from_user.id),
    content_types=["text", "document", "photo", "video", "audio", "voice"]
)
def handle_import_users(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    added = 0

    if msg.forward_from and not msg.forward_from.is_bot:
        f_uid = str(msg.forward_from.id)
        if f_uid not in users_db:
            added += 1
        track_user(msg.forward_from)

    raw_text = msg.text or msg.caption or ""
    if msg.document:
        try:
            p = download_file(msg.document.file_id, suffix=".txt")
            with open(p, "r", encoding="utf-8", errors="ignore") as f:
                raw_text += "\n" + f.read()
            os.remove(p)
        except Exception:
            pass

    found_ids = re.findall(r"\b\d{6,12}\b", raw_text)
    for f_id in found_ids:
        if f_id not in users_db:
            track_user(int(f_id))
            added += 1

    reset_session(chat_id, uid)
    bot.send_message(
        chat_id,
        f"✅ <b>Импорт завершён!</b> Добавлено: <code>{added}</code>",
        reply_markup=admin_kb(),
        parse_mode="HTML"
    )

@bot.message_handler(
    func=lambda m: get_session(m.chat.id, m.from_user.id).get("step") == "WAIT_BROADCAST" and is_admin(m.from_user.id),
    content_types=["text", "photo", "video", "audio", "document", "voice", "video_note", "animation", "sticker"]
)
def handle_broadcast_message(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    if msg.text and msg.text.startswith("/"):
        reset_session(chat_id, uid)
        bot.send_message(chat_id, "❌ Рассылка отменена.")
        return

    reset_session(chat_id, uid)
    all_uids = list(users_db.keys())
    total = len(all_uids)
    sent = 0
    failed = 0

    status_msg = bot.send_message(chat_id, f"⏳ Рассылка: <code>0 / {total}</code>", parse_mode="HTML")

    for idx, target_uid_str in enumerate(all_uids, 1):
        try:
            bot.copy_message(
                chat_id=int(target_uid_str),
                from_chat_id=msg.chat.id,
                message_id=msg.message_id,
                reply_markup=msg.reply_markup
            )
            users_db[target_uid_str]["blocked"] = False
            sent += 1
        except Exception:
            users_db[target_uid_str]["blocked"] = True
            failed += 1

        if idx % 20 == 0 or idx == total:
            try:
                bot.edit_message_text(
                    f"⏳ Рассылка: <code>{idx} / {total}</code> (✅ {sent}, 🚫 {failed})",
                    chat_id,
                    status_msg.message_id,
                    parse_mode="HTML"
                )
            except Exception:
                pass
        time.sleep(0.04)

    save_users_db()

    try:
        bot.edit_message_text(
            f"✅ <b>Рассылка завершена!</b>\nДоставлено: <b>{sent}</b> | Ошибок: <b>{failed}</b>",
            chat_id,
            status_msg.message_id,
            reply_markup=admin_kb(),
            parse_mode="HTML"
        )
    except Exception:
        pass

def _route_document(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    is_group = msg.chat.type in ("group", "supergroup")
    u     = get_session(chat_id, uid)
    mime  = msg.document.mime_type or ""
    fname = msg.document.file_name or ""

    if u["step"] == "WAIT_COVER" and mime.startswith("image/"):
        if not ensure_sub(msg.from_user, msg.chat):
            return
        _save_cover_from_file_id(chat_id, uid, u, msg.document.file_id, msg.chat.type)
        return

    ext = detect_audio_ext(mime, fname)
    if not ext:
        if not is_group:
            if not ensure_sub(msg.from_user, msg.chat):
                return
            supported = ", ".join(sorted(FMT_NAME.values()))
            bot.send_message(chat_id, f"⚠️ Формат не поддерживается. Поддерживаю: <b>{supported}</b>", parse_mode="HTML")
        return

    if not ensure_sub(msg.from_user, msg.chat):
        return
    is_vid = mime.startswith("video/") or ext in VIDEO_EXTS
    _handle_audio_file(chat_id, uid, u, msg.document.file_id, mime, fname, is_video=is_vid)

def _save_cover_from_file_id(chat_id: int, uid: int, u: dict, file_id: str, chat_type: str = "private"):
    try:
        path = download_file(file_id, suffix=".jpg")
    except Exception as e:
        log.exception(e)
        bot.send_message(chat_id, "❌ Не удалось скачать аватарку.")
        return
    u["cover_path"] = path
    do_save(chat_id, uid, chat_type)

def _handle_audio_file(chat_id: int, uid: int, u: dict, file_id: str, mime: str, fname: str, is_video: bool = False):
    if u["step"] == "WAIT_COVER":
        bot.send_message(chat_id, "⚠️ Жду аватарку трека, не аудио/видео.")
        return
    ext = detect_audio_ext(mime, fname) or (".mp4" if is_video else ".mp3")
    if ext in VIDEO_EXTS or mime.startswith("video/"):
        is_video = True

    wm = bot.send_message(chat_id, f"{ce(E_SEND, '📤')} {'вырезаю звук из видео...' if is_video else 'скачиваю трек...'}", parse_mode="HTML")
    try:
        path = download_file(file_id, suffix=ext)
        if is_video:
            path = extract_audio_from_video(path)
            ext = ".mp3"
    except Exception as e:
        log.exception(e)
        bot.edit_message_text(f"❌ {e}", chat_id, wm.message_id)
        return

    try: bot.delete_message(chat_id, wm.message_id)
    except Exception: pass
    reset_session(chat_id, uid)
    u = get_session(chat_id, uid)
    u["audio_path"] = path
    u["fmt"]        = ext
    ask_title(chat_id, uid)

@bot.message_handler(content_types=["audio"])
def handle_audio(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    if not ensure_sub(msg.from_user, msg.chat):
        return
    u = get_session(chat_id, uid)
    _handle_audio_file(chat_id, uid, u, msg.audio.file_id, msg.audio.mime_type or "", msg.audio.file_name or "", is_video=False)

@bot.message_handler(content_types=["voice"])
def handle_voice(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    if not ensure_sub(msg.from_user, msg.chat):
        return
    u = get_session(chat_id, uid)
    _handle_audio_file(chat_id, uid, u, msg.voice.file_id, msg.voice.mime_type or "audio/ogg", "voice.ogg", is_video=True)

@bot.message_handler(content_types=["video"])
def handle_video(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    if not ensure_sub(msg.from_user, msg.chat):
        return
    u = get_session(chat_id, uid)
    _handle_audio_file(chat_id, uid, u, msg.video.file_id, msg.video.mime_type or "video/mp4", msg.video.file_name or "video.mp4", is_video=True)

@bot.message_handler(content_types=["video_note"])
def handle_video_note(msg: types.Message):
