    chat_id = msg.chat.id
    if not ensure_sub(msg.from_user, msg.chat):
        return
    u = get_session(chat_id, uid)
    _handle_audio_file(chat_id, uid, u, msg.video_note.file_id, "video/mp4", "video_note.mp4", is_video=True)

@bot.message_handler(content_types=["document"])
def handle_document(msg: types.Message):
    _route_document(msg)

@bot.message_handler(content_types=["photo"])
def handle_photo(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    is_group = msg.chat.type in ("group", "supergroup")
    u = get_session(chat_id, uid)
    if u["step"] != "WAIT_COVER":
        if not is_group:
            if not ensure_sub(msg.from_user, msg.chat):
                return
            bot.send_message(chat_id, "⚠️ Сначала отправь аудио или видео.")
        return
    if not ensure_sub(msg.from_user, msg.chat):
        return
    _save_cover_from_file_id(chat_id, uid, u, msg.photo[-1].file_id, msg.chat.type)

@bot.message_handler(content_types=["text"])
def handle_text(msg: types.Message):
    uid = msg.from_user.id
    chat_id = msg.chat.id
    is_group = msg.chat.type in ("group", "supergroup")
    text = msg.text.strip()
    if text.startswith("/"):
        return
    u = get_session(chat_id, uid)
    step = u.get("step")

    if is_group and step == "WAIT_AUDIO":
        track_user(msg.from_user)
        return

    if not ensure_sub(msg.from_user, msg.chat):
        return

    if step == "WAIT_TITLE":
        try: bot.delete_message(chat_id, msg.message_id)
        except Exception: pass
        u["title"] = text
        ask_artist(chat_id, uid)
    elif step == "WAIT_ARTIST":
        try: bot.delete_message(chat_id, msg.message_id)
        except Exception: pass
        u["artist"] = text
        ask_cover(chat_id, uid)
    elif step == "WAIT_COVER":
        if not is_group:
            bot.send_message(chat_id, f"{ce(E_COVER, '🖼️')} Жду фото для аватарки!", parse_mode="HTML")

@bot.callback_query_handler(func=lambda c: c.data in ("admin_panel", "admin_stats", "admin_users_list", "admin_import", "admin_broadcast", "admin_close"))
def handle_admin_callbacks(call: types.CallbackQuery):
    uid = call.from_user.id
    chat_id = call.message.chat.id
    track_user(call.from_user)
    if not is_admin(uid):
        bot.answer_callback_query(call.id, "⛔ Доступ запрещён", show_alert=True)
        return

    if call.data in ("admin_panel", "admin_stats"):
        get_session(chat_id, uid)["step"] = "WAIT_AUDIO"
        bot.answer_callback_query(call.id, "Обновлено" if call.data == "admin_stats" else None)
        text = get_stats_text()
        try:
            bot.edit_message_text(text, chat_id, call.message.message_id, reply_markup=admin_kb(), parse_mode="HTML")
        except Exception:
            pass

    elif call.data == "admin_users_list":
        bot.answer_callback_query(call.id)
        sorted_users = sorted(users_db.items(), key=lambda x: x[1].get("joined", 0), reverse=True)
        short_lines = [f"📋 <b>Пользователи ({len(users_db)}):</b>\n"]
        for idx, (u_id, info) in enumerate(sorted_users[:25], 1):
            uname = f"@{info['username']}" if info.get("username") else info.get("name") or u_id
            st = "🚫" if info.get("blocked") else "✅"
            short_lines.append(f"{idx}. {st} <code>{u_id}</code> ({uname}) | 🎵 {info.get('tracks', 0)}")
        kb_back = types.InlineKeyboardMarkup()
        kb_back.add(types.InlineKeyboardButton("🔙 Назад", callback_data="admin_panel"))
        try:
            bot.edit_message_text("\n".join(short_lines), chat_id, call.message.message_id, reply_markup=kb_back, parse_mode="HTML")
        except Exception:
            bot.send_message(chat_id, "\n".join(short_lines), reply_markup=kb_back, parse_mode="HTML")

    elif call.data == "admin_import":
        bot.answer_callback_query(call.id)
        get_session(chat_id, uid)["step"] = "WAIT_IMPORT"
        text = "📥 Отправьте файл .txt с ID или перешлите сообщение пользователя для импорта в базу."
        try:
            bot.edit_message_text(text, chat_id, call.message.message_id, reply_markup=cancel_action_kb(), parse_mode="HTML")
        except Exception:
            bot.send_message(chat_id, text, reply_markup=cancel_action_kb(), parse_mode="HTML")

    elif call.data == "admin_broadcast":
        bot.answer_callback_query(call.id)
        get_session(chat_id, uid)["step"] = "WAIT_BROADCAST"
        text = f"📢 Отправьте пост для рассылки по базе ({len(users_db)} чел.):"
        try:
            bot.edit_message_text(text, chat_id, call.message.message_id, reply_markup=cancel_action_kb(), parse_mode="HTML")
        except Exception:
            bot.send_message(chat_id, text, reply_markup=cancel_action_kb(), parse_mode="HTML")

    elif call.data == "admin_close":
        get_session(chat_id, uid)["step"] = "WAIT_AUDIO"
        bot.answer_callback_query(call.id)
        try:
            bot.edit_message_text(
                f"{ce(E_MUSIC, '🎵')} Пришли трек, чтобы изменить название, исполнителя или аватарку трека.",
                chat_id,
                call.message.message_id,
                reply_markup=start_kb(uid, call.message.chat.type),
                parse_mode="HTML"
            )
        except Exception:
            pass

@bot.callback_query_handler(func=lambda c: c.data == "check_sub")
def handle_check_sub(call: types.CallbackQuery):
    uid = call.from_user.id
    chat_id = call.message.chat.id
    track_user(call.from_user)
    bot.answer_callback_query(call.id)

    tmp_msg = bot.send_message(chat_id, ce(E_SUB_BTN, "⏳"), parse_mode="HTML")
    time.sleep(0.8)
    try: bot.delete_message(chat_id, tmp_msg.message_id)
    except Exception: pass

    if call.message.chat.type in ("group", "supergroup") or is_subscribed(uid):
        try: bot.delete_message(chat_id, call.message.message_id)
        except Exception: pass
        bot.send_message(chat_id, f"{ce(E_MUSIC, '🎵')} Пришли трек, чтобы изменить название, исполнителя или аватарку трека.", reply_markup=start_kb(uid, call.message.chat.type), parse_mode="HTML")
    else:
        try: bot.delete_message(chat_id, call.message.message_id)
        except Exception: pass
        send_sub_prompt(chat_id)

@bot.callback_query_handler(func=lambda c: c.data.startswith("skip"))
def handle_skip(call: types.CallbackQuery):
    uid = call.from_user.id
    chat_id = call.message.chat.id
    if ":" in call.data:
        owner_id = int(call.data.split(":")[1])
        if uid != owner_id:
            bot.answer_callback_query(call.id, "⚠️ Кнопка не для вас!", show_alert=True)
            return

    if not ensure_sub(call.from_user, call.message.chat):
        bot.answer_callback_query(call.id)
        return
    u = get_session(chat_id, uid)
    bot.answer_callback_query(call.id)
    step = u.get("step")
    if step == "WAIT_TITLE":
        ask_artist(chat_id, uid)
    elif step == "WAIT_ARTIST":
        ask_cover(chat_id, uid)
    elif step == "WAIT_COVER":
        do_save(chat_id, uid, call.message.chat.type)

if __name__ == "__main__":
    log.info("🎵 Bot started")
    bot.infinity_polling(
        timeout=60,
        long_polling_timeout=30,
        allowed_updates=["message", "callback_query", "chat_member", "my_chat_member"]
    )
