    ".mp3": "MP3", ".m4a": "M4A", ".mp4": "MP4", ".mov": "MOV", ".mkv": "MKV", ".avi": "AVI",
    ".aac": "AAC", ".ogg": "OGG", ".opus": "OPUS", ".flac": "FLAC",
    ".wav": "WAV", ".wma": "WMA", ".webm": "WebM",
}
VIDEO_EXTS = {".mp4", ".mov", ".mkv", ".avi", ".webm"}

def get_ffmpeg_cmd() -> str:
    path = shutil.which("ffmpeg")
    if path:
        return path
    try:
        import imageio_ffmpeg
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        return "ffmpeg"

def extract_audio_from_video(video_path: str) -> str:
    out_mp3 = video_path + "_extracted.mp3"
    ffmpeg_bin = get_ffmpeg_cmd()
    
    # Проверяем, есть ли вообще аудиопоток в видео
    try:
        probe_cmd = [ffmpeg_bin, "-i", video_path]
        res_probe = subprocess.run(probe_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if "Audio:" not in res_probe.stderr:
            raise RuntimeError("В этом видеофайле отсутствует аудиодорожка!")
    except Exception as e:
        if "отсутствует" in str(e):
            raise e

    try:
        cmd = [
            ffmpeg_bin, "-y", "-i", video_path,
            "-vn", "-acodec", "libmp3lame", "-ab", "192k", "-ar", "44100",
            out_mp3
        ]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if res.returncode == 0 and os.path.exists(out_mp3) and os.path.getsize(out_mp3) > 0:
            try: os.remove(video_path)
            except Exception: pass
            return out_mp3
    except Exception as e:
        log.warning(f"ffmpeg extraction failed: {e}")

    try:
        from pydub import AudioSegment
        audio = AudioSegment.from_file(video_path)
        audio.export(out_mp3, format="mp3", bitrate="192k")
        if os.path.exists(out_mp3) and os.path.getsize(out_mp3) > 0:
            try: os.remove(video_path)
            except Exception: pass
            return out_mp3
    except Exception as e:
        log.warning(f"pydub extraction failed: {e}")

    raise RuntimeError("Не удалось извлечь звук (возможно, файл поврежден или не содержит аудио).")

def fetch_telegram_mau() -> int:
    try:
        r = requests.get(f"https://t.me/{BOT_USERNAME}", timeout=5)
        m = re.search(r"([\d\s]+)\s+monthly users", r.text, re.IGNORECASE)
        if m:
            return int(re.sub(r"\D", "", m.group(1)))
    except Exception:
        pass
    return 84

def load_users_db() -> dict[str, dict]:
    if os.path.exists(DB_FILE):
        try:
            with open(DB_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, list):
                    now = time.time()
                    return {str(u): {"joined": now, "last_active": now, "tracks": 0, "blocked": False, "username": "", "name": ""} for u in data}
                if isinstance(data, dict):
                    return data
        except Exception as e:
            log.warning(f"Failed to load {DB_FILE}: {e}")
    return {}

def save_users_db():
    try:
        with open(DB_FILE, "w", encoding="utf-8") as f:
            json.dump(users_db, f, ensure_ascii=False, indent=2)
    except Exception as e:
        log.warning(f"Failed to save {DB_FILE}: {e}")

users_db: dict[str, dict] = load_users_db()

def track_user(user: types.User | int, inc_track: bool = False):
    now = time.time()
    if isinstance(user, int):
        uid_str = str(user)
        uname = ""
        fname = ""
    else:
        uid_str = str(user.id)
        uname = user.username or ""
        fname = f"{user.first_name or ''} {user.last_name or ''}".strip()

    if uid_str not in users_db:
        users_db[uid_str] = {
            "joined": now,
            "last_active": now,
            "tracks": 1 if inc_track else 0,
            "blocked": False,
            "username": uname,
            "name": fname
        }
    else:
        users_db[uid_str]["last_active"] = now
        users_db[uid_str]["blocked"] = False
        if uname:
            users_db[uid_str]["username"] = uname
        if fname:
            users_db[uid_str]["name"] = fname
        if inc_track:
            users_db[uid_str]["tracks"] = users_db[uid_str].get("tracks", 0) + 1
    save_users_db()

@bot.chat_member_handler()
def handle_chat_member_update(update: types.ChatMemberUpdated):
    if update.from_user and not update.from_user.is_bot:
        track_user(update.from_user)
    if update.new_chat_member and update.new_chat_member.user and not update.new_chat_member.user.is_bot:
        track_user(update.new_chat_member.user)

def get_stats_text() -> str:
    tg_mau = fetch_telegram_mau()
    total_db = len(users_db)
    total_all = max(tg_mau, total_db)
    active_all = sum(1 for v in users_db.values() if not v.get("blocked", False))
    total_tracks = sum(v.get("tracks", 0) for v in users_db.values())

    # Сокращенный и компактный вид статистики
    return (
        f"📊 <b>Статистика бота</b>\n\n"
        f"👥 Всего (за месяц): <b>{total_all}</b>\n"
        f"💾 В базе (для рассылки): <b>{total_db}</b> (активных: {active_all})\n"
        f"🎵 Обработано треков: <b>{total_tracks}</b>"
    )

def is_admin(uid: int) -> bool:
    return uid in ADMIN_IDS

def start_kb(uid: int, chat_type: str = "private") -> types.InlineKeyboardMarkup:
    kb = types.InlineKeyboardMarkup()
    kb.add(types.InlineKeyboardButton("владелец", url="https://t.me/vk_only"))
    if is_admin(uid) and chat_type == "private":
        kb.add(types.InlineKeyboardButton("⚙️ Админ-панель", callback_data="admin_panel"))
    return kb

